<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.bibliotheque.controller.MemberDashboardController"
            styleClass="main-root">

    <top>
        <HBox styleClass="navbar" alignment="CENTER_LEFT" spacing="16">
            <Label text="📚 Ma Bibliothèque" styleClass="navbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblWelcome" styleClass="navbar-user"/>
            <Button text="🚪 Déconnexion" onAction="#handleLogout" styleClass="btn-logout"/>
        </HBox>
    </top>

    <center>
        <TabPane styleClass="main-tabs" tabClosingPolicy="UNAVAILABLE">

            <!-- Browse Books -->
            <Tab text="📖 Catalogue">
                <VBox spacing="12" styleClass="tab-content">
                    <HBox spacing="12" alignment="CENTER_LEFT">
                        <TextField fx:id="txtSearch" promptText="🔍 Rechercher titre, auteur, genre..." styleClass="search-field" HBox.hgrow="ALWAYS"/>
                        <Button text="Rechercher" onAction="#handleSearch" styleClass="btn-secondary"/>
                        <Button text="Tout Afficher" onAction="#handleRefresh" styleClass="btn-secondary"/>
                    </HBox>
                    <TableView fx:id="tableBooks" VBox.vgrow="ALWAYS" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="colTitle" text="Titre" prefWidth="240"/>
                            <TableColumn fx:id="colAuthor" text="Auteur" prefWidth="180"/>
                            <TableColumn fx:id="colGenre" text="Genre" prefWidth="110"/>
                            <TableColumn fx:id="colYear" text="Année" prefWidth="70"/>
                            <TableColumn fx:id="colAvail" text="Disponible" prefWidth="90"/>
                            <TableColumn fx:id="colAction" text="Action" prefWidth="130"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- My Loans -->
            <Tab text="🔖 Mes Emprunts">
                <VBox spacing="12" styleClass="tab-content">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Historique de mes emprunts" styleClass="section-title"/>
                    </HBox>
                    <TableView fx:id="tableMyLoans" VBox.vgrow="ALWAYS" styleClass="data-table">
                        <columns>
                            <TableColumn fx:id="colLoanBook" text="Livre" prefWidth="260"/>
                            <TableColumn fx:id="colLoanAuthor" text="Auteur" prefWidth="180"/>
                            <TableColumn fx:id="colLoanDate" text="Emprunté le" prefWidth="120"/>
                            <TableColumn fx:id="colLoanDue" text="À rendre le" prefWidth="120"/>
                            <TableColumn fx:id="colLoanReturn" text="Rendu le" prefWidth="120"/>
                            <TableColumn fx:id="colLoanStatus" text="Statut" prefWidth="100"/>
                        </columns>
                    </TableView>
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
